diff --git a/src/vulkan/vulkan_presenter.cpp b/src/vulkan/vulkan_presenter.cpp
index b02869e..618551a 100644
--- a/src/vulkan/vulkan_presenter.cpp
+++ b/src/vulkan/vulkan_presenter.cpp
@@ -1,7 +1,239 @@
+#include <functional>
 #include "vulkan_presenter.h"
 
 #include "../dxvk/dxvk_format.h"
 
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+#include <chrono>
+
+
+namespace dxvk::vk {
+
+  /**
+   * Wine 9.0 cannot create a Vulkan surface for child windows (or for windows that contain child windows). When that
+   * fails, render into a separate child-less popup window instead and keep it on top of the real window's client area.
+   * The popup lives on its own thread with its own message loop and forwards mouse input to the real window.
+   */
+  class OverlayWindow {
+
+  public:
+
+    OverlayWindow(HWND target, UINT width, UINT height)
+    : m_target(target) {
+      m_thread = std::thread([this, width, height] { run(width, height); });
+
+      std::unique_lock<std::mutex> lock(m_mutex);
+      m_cond.wait_for(lock, std::chrono::seconds(5), [this] { return m_ready; });
+    }
+
+    ~OverlayWindow() {
+      if (m_hwnd)
+        ::PostMessageA(m_hwnd, WM_CLOSE, 0, 0);
+
+      if (m_thread.joinable())
+        m_thread.join();
+    }
+
+    HWND handle() const {
+      return m_hwnd;
+    }
+
+    void sync() {
+      if (!m_hwnd)
+        return;
+
+      HWND root = ::GetAncestor(m_target, GA_ROOT);
+      // Diagnostic: CTBLOX_OVERLAY_HIDE keeps the overlay hidden so the real window underneath can be seen.
+      static const bool hideOverlay = ::GetEnvironmentVariableA("CTBLOX_OVERLAY_HIDE", nullptr, 0) != 0;
+      bool visible = !hideOverlay && ::IsWindow(m_target) && ::IsWindowVisible(m_target) && !::IsIconic(root);
+
+      RECT rect = { };
+      POINT origin = { 0, 0 };
+      ::GetClientRect(m_target, &rect);
+      ::ClientToScreen(m_target, &origin);
+
+      int width  = rect.right  - rect.left;
+      int height = rect.bottom - rect.top;
+
+      if (!visible || width <= 0 || height <= 0) {
+        if (m_shown) {
+          ::ShowWindow(m_hwnd, SW_HIDE);
+          m_shown = false;
+        }
+        return;
+      }
+
+      // Keep the overlay directly above the real top-level window, but below any dialog or menu that is
+      // stacked above that window. A topmost overlay would hide Qt's login dialog and popup menus.
+      bool aboveRoot = false;
+      HWND below = m_hwnd;
+      for (int i = 0; i < 64 && below; i++) {
+        below = ::GetWindow(below, GW_HWNDNEXT);
+        if (below == root) {
+          aboveRoot = true;
+          break;
+        }
+      }
+
+      bool moved = origin.x != m_x || origin.y != m_y || width != m_width || height != m_height;
+
+      if (!m_shown || moved || !aboveRoot) {
+        HWND after = HWND_TOP;
+        UINT flags = SWP_NOACTIVATE | SWP_SHOWWINDOW;
+
+        if (!m_shown || !aboveRoot) {
+          HWND prev = ::GetWindow(root, GW_HWNDPREV);
+          if (prev)
+            after = prev;
+        } else {
+          flags |= SWP_NOZORDER;
+        }
+
+        ::SetWindowPos(m_hwnd, after, origin.x, origin.y, width, height, flags);
+        m_shown  = true;
+        m_x      = origin.x;
+        m_y      = origin.y;
+        m_width  = width;
+        m_height = height;
+      }
+
+      logWindows(root, origin, width, height);
+    }
+
+    // Diagnostic: describes which windows sit on top of the Studio window, to find out what is actually visible.
+    void logWindows(HWND root, POINT origin, int width, int height) {
+      if (m_logCount >= 5 || width < 600)
+        return;
+
+      DWORD now = ::GetTickCount();
+      if (m_logCount > 0 && now - m_lastLog < 6000)
+        return;
+      if (m_logCount == 0 && now - m_createdAt < 8000)
+        return;
+
+      m_logCount++;
+      m_lastLog = now;
+
+      auto describe = [] (HWND hwnd) {
+        char cls[64] = { };
+        ::GetClassNameA(hwnd, cls, sizeof(cls) - 1);
+        RECT r = { };
+        ::GetWindowRect(hwnd, &r);
+        return str::format("hwnd=0x", std::hex, uint64_t(uintptr_t(hwnd)), std::dec, " class=", cls,
+          " visible=", int(::IsWindowVisible(hwnd)), " rect=", r.left, ",", r.top, " ", r.right - r.left, "x", r.bottom - r.top,
+          " style=0x", std::hex, uint64_t(::GetWindowLongA(hwnd, GWL_STYLE)), " ex=0x", uint64_t(::GetWindowLongA(hwnd, GWL_EXSTYLE)), std::dec);
+      };
+
+      POINT center = { origin.x + width / 2, origin.y + height / 2 };
+      HWND atPoint = ::WindowFromPoint(center);
+      Logger::warn(str::format("ctblox: windows #", m_logCount, " overlay: ", describe(m_hwnd), " | target: ", describe(m_target),
+        " | root: ", describe(root), " | atCenter: ", atPoint ? describe(atPoint) : std::string("none")));
+
+      struct Ctx { std::function<std::string(HWND)>* describe; HWND overlay; HWND root; int count; } ctx = { nullptr, m_hwnd, root, 0 };
+      std::function<std::string(HWND)> describeFn = describe;
+      ctx.describe = &describeFn;
+
+      ::EnumWindows([] (HWND hwnd, LPARAM lparam) -> BOOL {
+        Ctx* c = reinterpret_cast<Ctx*>(lparam);
+        if (c->count++ >= 12)
+          return FALSE;
+        Logger::warn(str::format("ctblox:   top-level #", c->count, hwnd == c->overlay ? " [overlay] " : hwnd == c->root ? " [root] " : " ",
+          (*c->describe)(hwnd)));
+        return TRUE;
+      }, reinterpret_cast<LPARAM>(&ctx));
+
+      ctx.count = 0;
+      ::EnumChildWindows(root, [] (HWND hwnd, LPARAM lparam) -> BOOL {
+        Ctx* c = reinterpret_cast<Ctx*>(lparam);
+        if (c->count++ >= 16)
+          return FALSE;
+        Logger::warn(str::format("ctblox:   root child #", c->count, " ", (*c->describe)(hwnd)));
+        return TRUE;
+      }, reinterpret_cast<LPARAM>(&ctx));
+    }
+
+  private:
+
+    HWND                    m_target  = nullptr;
+    HWND                    m_hwnd    = nullptr;
+    std::thread             m_thread;
+    std::mutex              m_mutex;
+    std::condition_variable m_cond;
+    bool                    m_ready   = false;
+    bool                    m_shown   = false;
+    int                     m_x = 0, m_y = 0, m_width = 0, m_height = 0;
+    uint32_t                m_logCount = 0;
+    DWORD                   m_lastLog = 0;
+    DWORD                   m_createdAt = ::GetTickCount();
+
+    void run(UINT width, UINT height) {
+      HINSTANCE instance = ::GetModuleHandleA(nullptr);
+
+      WNDCLASSA wc = { };
+      wc.lpfnWndProc   = &OverlayWindow::windowProc;
+      wc.hInstance     = instance;
+      wc.lpszClassName = "DxvkSurfaceOverlay";
+      ::RegisterClassA(&wc);
+
+      HWND hwnd = ::CreateWindowExA(WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW, wc.lpszClassName, "", WS_POPUP,
+        0, 0, int(width ? width : 1), int(height ? height : 1), nullptr, nullptr, instance, nullptr);
+
+      if (hwnd)
+        ::SetWindowLongPtrA(hwnd, GWLP_USERDATA, LONG_PTR(m_target));
+
+      {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_hwnd  = hwnd;
+        m_ready = true;
+      }
+      m_cond.notify_all();
+
+      if (!hwnd)
+        return;
+
+      MSG msg;
+      while (::GetMessageA(&msg, nullptr, 0, 0) > 0) {
+        ::TranslateMessage(&msg);
+        ::DispatchMessageA(&msg);
+      }
+    }
+
+    static LRESULT CALLBACK windowProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam) {
+      HWND target = HWND(::GetWindowLongPtrA(hwnd, GWLP_USERDATA));
+
+      switch (msg) {
+        case WM_MOUSEACTIVATE:
+          return MA_NOACTIVATE;
+
+        case WM_CLOSE:
+          ::DestroyWindow(hwnd);
+          return 0;
+
+        case WM_DESTROY:
+          ::PostQuitMessage(0);
+          return 0;
+
+        case WM_MOUSEMOVE:
+        case WM_LBUTTONDOWN: case WM_LBUTTONUP: case WM_LBUTTONDBLCLK:
+        case WM_RBUTTONDOWN: case WM_RBUTTONUP: case WM_RBUTTONDBLCLK:
+        case WM_MBUTTONDOWN: case WM_MBUTTONUP: case WM_MBUTTONDBLCLK:
+        case WM_XBUTTONDOWN: case WM_XBUTTONUP:
+        case WM_MOUSEWHEEL:  case WM_MOUSEHWHEEL:
+          // The overlay covers the target's client area exactly, so client coordinates carry over unchanged.
+          if (target)
+            ::PostMessageA(target, msg, wParam, lParam);
+          return 0;
+      }
+
+      return ::DefWindowProcA(hwnd, msg, wParam, lParam);
+    }
+
+  };
+
+}
+
