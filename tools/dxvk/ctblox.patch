@@ -457,7 +610,33 @@ namespace dxvk::vk {
     
     VkResult status = m_vki->vkCreateWin32SurfaceKHR(
       m_vki->instance(), &info, nullptr, &m_surface);
-    
+
+    if (status != VK_SUCCESS) {
+      Logger::warn(str::format("Presenter: vkCreateWin32SurfaceKHR failed (", status, ") for hwnd ", m_window,
+        " style=0x", std::hex, ::GetWindowLongA(m_window, GWL_STYLE), std::dec,
+        " parent=", ::GetAncestor(m_window, GA_PARENT), " desktop=", ::GetDesktopWindow(),
+        " hasChild=", ::FindWindowExA(m_window, nullptr, nullptr, nullptr) != nullptr ? 1 : 0,
+        "; falling back to an overlay window"));
+
+      if (!m_overlay) {
+        RECT rect = { };
+        ::GetClientRect(m_window, &rect);
+        UINT width  = rect.right  > rect.left ? UINT(rect.right  - rect.left) : m_desiredExtent.width;
+        UINT height = rect.bottom > rect.top  ? UINT(rect.bottom - rect.top)  : m_desiredExtent.height;
+        m_overlay = new OverlayWindow(m_window, width, height);
+      }
+
+      OverlayWindow* overlay = static_cast<OverlayWindow*>(m_overlay);
+      if (!overlay->handle())
+        return status;
+
+      overlay->sync();
+      info.hinstance = ::GetModuleHandleA(nullptr);
+      info.hwnd      = overlay->handle();
+      status = m_vki->vkCreateWin32SurfaceKHR(m_vki->instance(), &info, nullptr, &m_surface);
+      Logger::warn(str::format("Presenter: overlay window ", info.hwnd, " surface result: ", status));
+    }
+
     if (status != VK_SUCCESS)
       return status;
     
