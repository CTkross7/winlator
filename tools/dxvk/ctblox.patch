+  class OverlayWindow {
+
+  public:
+
+    OverlayWindow(HWND target, UINT width, UINT height)
+    : m_target(target) {
+      m_thread = std::thread([this, width, height] { run(width, height); });
+
+      std::unique_lock<std::mutex> lock(m_mutex);
+      m_cond.wait_for(lock, std::chrono::seconds(5), [this] { return m_ready; });
+    }
+
+    ~OverlayWindow() {
+      if (m_hwnd)
