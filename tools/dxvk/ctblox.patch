+  void D3D11SwapChain::DumpCapturedTextures(D3D11ImmediateContext* pContext) {
+    std::vector<Rc<DxvkImage>> images;
+    {
+      std::lock_guard<std::mutex> lock(g_ctbloxImageMutex);
+      images.swap(g_ctbloxImages);
+    }
+
+    if (images.empty())
+      return;
+
+    std::string dir = env::getEnvVar("DXVK_LOG_PATH");
+    if (dir.empty())
+      dir = "D:/";
+    if (dir.back() != '/' && dir.back() != '\\')
+      dir += '/';
+
+    Rc<DxvkDevice> device = m_device;
+    auto lock = pContext->LockContext();
+
+    pContext->EmitCs([=] (DxvkContext* ctx) {
+      uint32_t number = 0;
+
+      Logger::warn(str::format("ctblox: draws into the 512x1024 atlas so far: ", uint32_t(g_ctbloxAtlasDraws)));
+
+      for (const Rc<DxvkImage>& image : images)
+      for (uint32_t mip = 0; mip < std::min<uint32_t>(image->info().mipLevels, 3); mip++) {
+        const VkExtent3D fullExtent = image->info().extent;
+        const VkExtent3D extent = { std::max(1u, fullExtent.width >> mip), std::max(1u, fullExtent.height >> mip), 1u };
+        const VkFormat format = image->info().format;
+        const bool swapRB = format == VK_FORMAT_R8G8B8A8_UNORM || format == VK_FORMAT_R8G8B8A8_SRGB;
+        const size_t pixels = size_t(extent.width) * extent.height;
+
+        DxvkBufferCreateInfo bufferInfo;
+        bufferInfo.size   = VkDeviceSize(pixels) * 4;
+        bufferInfo.usage  = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+        bufferInfo.stages = VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_HOST_BIT;
+        bufferInfo.access = VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_HOST_READ_BIT;
+
+        Rc<DxvkBuffer> buffer = device->createBuffer(bufferInfo,
+          VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+
+        VkImageSubresourceLayers layers = { VK_IMAGE_ASPECT_COLOR_BIT, mip, 0, 1 };
+
+        ctx->copyImageToBuffer(buffer, 0, VkDeviceSize(extent.width) * 4, VkDeviceSize(pixels) * 4,
+          image, layers, VkOffset3D { 0, 0, 0 }, extent);
+        ctx->flushCommandList();
+        device->waitForIdle();
+
+        const uint8_t* src = reinterpret_cast<const uint8_t*>(buffer->mapPtr(0));
+        uint64_t sum[4] = { 0, 0, 0, 0 };
+        size_t nonZero = 0, nonWhite = 0;
+
+        // Large textures are written at reduced size (every step-th pixel) to keep the files uploadable.
+        uint32_t step = 1;
+        while (pixels / (size_t(step) * step) > 1000000)
+          step++;
+        const uint32_t outW = extent.width / step, outH = extent.height / step;
+        std::vector<uint8_t> rgb(size_t(outW) * outH * 3), alpha(size_t(outW) * outH);
+
+        for (size_t i = 0; i < pixels; i++) {
+          uint8_t c0 = src[i * 4 + 0], c1 = src[i * 4 + 1], c2 = src[i * 4 + 2], a = src[i * 4 + 3];
+          uint8_t r = swapRB ? c0 : c2;
+          uint8_t b = swapRB ? c2 : c0;
+          sum[0] += r; sum[1] += c1; sum[2] += b; sum[3] += a;
+          if (r | c1 | b | a)
+            nonZero++;
+          if (!(r == 255 && c1 == 255 && b == 255 && a == 255))
+            nonWhite++;
+        }
+
+        for (uint32_t y = 0; y < outH; y++) {
+          for (uint32_t x = 0; x < outW; x++) {
+            const uint8_t* px = src + (size_t(y * step) * extent.width + size_t(x * step)) * 4;
+            uint8_t* o = rgb.data() + (size_t(y) * outW + x) * 3;
+            o[0] = swapRB ? px[0] : px[2];
+            o[1] = px[1];
+            o[2] = swapRB ? px[2] : px[0];
+            alpha[size_t(y) * outW + x] = px[3];
+          }
+        }
+
+        std::string path = str::format(dir, "ctblox_tex_", extent.width, "x", extent.height, "_", number, "_mip", mip, "_rgb.png");
+        std::string pathA = str::format(dir, "ctblox_tex_", extent.width, "x", extent.height, "_", number, "_mip", mip, "_alpha.png");
+        ctbloxWritePng(path, outW, outH, 3, rgb);
+        ctbloxWritePng(pathA, outW, outH, 1, alpha);
+
+        Logger::warn(str::format("ctblox: texture ", extent.width, "x", extent.height, " mip=", mip, " fmt=", uint32_t(format),
+          " nonZeroPixels=", nonZero, " nonWhitePixels=", nonWhite,
+          " avgRGBA=", sum[0] / pixels, ",", sum[1] / pixels, ",", sum[2] / pixels, ",", sum[3] / pixels,
+          " saved to ", path, " and ", pathA, " step=", step));
+        number++;
+      }
+    });
+
+    pContext->FlushCsChunk();
+  }
