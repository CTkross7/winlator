+    const auto& fsShader = m_state.gp.shaders.fs;
+    Logger::warn(str::format("ctblox: probe after app draw #", index, " samplesPassed=", samples, " fs=", (fsShader != nullptr ? fsShader->debugName() : std::string("-")),
+      " sc=", m_state.vp.scissorRects[0].extent.width, "x", m_state.vp.scissorRects[0].extent.height,
