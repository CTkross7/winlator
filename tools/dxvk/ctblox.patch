+        " dispatches=", stats.getCtr(DxvkStatCounter::CmdDispatchCalls),
+        " renderpasses=", stats.getCtr(DxvkStatCounter::CmdRenderPassCount),
+        " graphicsPipelines=", stats.getCtr(DxvkStatCounter::PipeCountGraphics),
+        " submits=", stats.getCtr(DxvkStatCounter::QueueSubmitCount),
+        " presents=", stats.getCtr(DxvkStatCounter::QueuePresentCount)));
+    });
+
+    pContext->FlushCsChunk();
+  }
