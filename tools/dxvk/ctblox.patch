+  // Minimal PNG writer (stored deflate blocks, no compression) so the files can be uploaded as ordinary images.
+  static void ctbloxWritePng(const std::string& path, uint32_t width, uint32_t height, uint32_t channels, const std::vector<uint8_t>& pixels) {
+    static uint32_t crcTable[256];
+    static bool crcInit = false;
+    if (!crcInit) {
+      for (uint32_t n = 0; n < 256; n++) {
+        uint32_t c = n;
+        for (int k = 0; k < 8; k++)
+          c = (c & 1) ? 0xEDB88320u ^ (c >> 1) : c >> 1;
+        crcTable[n] = c;
+      }
+      crcInit = true;
+    }
+
+    auto crc = [&] (const uint8_t* data, size_t size, uint32_t c) {
+      for (size_t i = 0; i < size; i++)
+        c = crcTable[(c ^ data[i]) & 0xFF] ^ (c >> 8);
+      return c;
+    };
+
+    std::vector<uint8_t> raw;
+    raw.reserve(size_t(height) * (size_t(width) * channels + 1));
+    for (uint32_t y = 0; y < height; y++) {
+      raw.push_back(0);
+      raw.insert(raw.end(), pixels.begin() + size_t(y) * width * channels, pixels.begin() + size_t(y + 1) * width * channels);
+    }
+
+    std::vector<uint8_t> z;
+    z.push_back(0x78);
+    z.push_back(0x01);
+    size_t pos = 0;
+    do {
+      size_t n = std::min<size_t>(65535, raw.size() - pos);
+      z.push_back(pos + n >= raw.size() ? 1 : 0);
+      z.push_back(uint8_t(n & 0xFF));
+      z.push_back(uint8_t(n >> 8));
+      z.push_back(uint8_t(~n & 0xFF));
+      z.push_back(uint8_t((~n >> 8) & 0xFF));
+      z.insert(z.end(), raw.begin() + pos, raw.begin() + pos + n);
+      pos += n;
+    } while (pos < raw.size());
+
+    uint32_t a = 1, b = 0;
+    for (uint8_t v : raw) {
+      a = (a + v) % 65521;
+      b = (b + a) % 65521;
+    }
+    uint32_t adler = (b << 16) | a;
+    for (int sh = 24; sh >= 0; sh -= 8)
+      z.push_back(uint8_t(adler >> sh));
+
+    std::ofstream file(path, std::ios::binary | std::ios::trunc);
+    const uint8_t sig[8] = { 0x89, 'P', 'N', 'G', 0x0D, 0x0A, 0x1A, 0x0A };
+    file.write(reinterpret_cast<const char*>(sig), 8);
+
+    auto chunk = [&] (const char* type, const std::vector<uint8_t>& data) {
+      std::vector<uint8_t> buf(4 + data.size());
+      std::memcpy(buf.data(), type, 4);
+      if (!data.empty())
+        std::memcpy(buf.data() + 4, data.data(), data.size());
+      uint32_t len = uint32_t(data.size());
+      uint8_t be[4] = { uint8_t(len >> 24), uint8_t(len >> 16), uint8_t(len >> 8), uint8_t(len) };
+      file.write(reinterpret_cast<const char*>(be), 4);
+      file.write(reinterpret_cast<const char*>(buf.data()), std::streamsize(buf.size()));
+      uint32_t c = crc(buf.data(), buf.size(), 0xFFFFFFFFu) ^ 0xFFFFFFFFu;
+      uint8_t ce[4] = { uint8_t(c >> 24), uint8_t(c >> 16), uint8_t(c >> 8), uint8_t(c) };
+      file.write(reinterpret_cast<const char*>(ce), 4);
+    };
+
+    std::vector<uint8_t> ihdr(13, 0);
+    ihdr[0] = uint8_t(width >> 24); ihdr[1] = uint8_t(width >> 16); ihdr[2] = uint8_t(width >> 8); ihdr[3] = uint8_t(width);
+    ihdr[4] = uint8_t(height >> 24); ihdr[5] = uint8_t(height >> 16); ihdr[6] = uint8_t(height >> 8); ihdr[7] = uint8_t(height);
+    ihdr[8] = 8;
+    ihdr[9] = channels == 3 ? 2 : 0;
+    chunk("IHDR", ihdr);
+    chunk("IDAT", z);
+    chunk("IEND", std::vector<uint8_t>());
+  }
