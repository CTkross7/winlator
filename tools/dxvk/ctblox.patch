+  void DxvkContext::ctbloxBeforeDraw() {
+    static const bool probeEnabled = !env::getEnvVar("CTBLOX_PROBE").empty();
+    const auto& rt = m_state.om.renderTargets.color[0];
+    if (!probeEnabled || rt.view == nullptr || rt.view->imageInfo().extent.width < 1000
+     || rt.view->imageInfo().format != VK_FORMAT_R8G8B8A8_UNORM || g_ctbloxProbes.load() >= 10)
+      return;
+
+    static const uint32_t probes[] = { 1, 2, 3, 4, 5, 6, 8, 12, 20, 40 };
+    for (uint32_t p : probes) {
+      if (p == m_ctbloxAppDraw + 1) {
+        // Count the samples this draw lets through the fragment tests.
+        m_ctbloxQuery = m_device->createGpuQuery(VK_QUERY_TYPE_OCCLUSION, 0, 0);
+        this->beginQuery(m_ctbloxQuery);
+        break;
+      }
+    }
+  }
+
+
+  void DxvkContext::ctbloxAfterDraw() {
+    m_ctbloxTraceActive = false;
+
+    const auto& rt = m_state.om.renderTargets.color[0];
+    if (rt.view == nullptr)
+      return;
+
+    const VkExtent3D ext = rt.view->imageInfo().extent;
+
+    // Draws into the 512x1024 UI atlas: log the first ones, and count them all.
+    if (ext.width == 512 && ext.height == 1024) {
+      uint32_t n = ++g_ctbloxAtlasDraws;
+      if (n <= 12) {
+        const auto& sh = m_state.gp.shaders;
+        Logger::warn(str::format("ctblox: atlas draw #", n, " fs=", (sh.fs != nullptr ? sh.fs->debugName() : std::string("-")),
+          " vp=", m_state.vp.viewports[0].width, "x", m_state.vp.viewports[0].height,
+          " sc=", m_state.vp.scissorRects[0].extent.width, "x", m_state.vp.scissorRects[0].extent.height));
+      }
+    }
+
+    if (ext.width > 1000)
+      m_ctbloxAppDraw++;
+
+    static const bool probeEnabled = !env::getEnvVar("CTBLOX_PROBE").empty();
+    if (!probeEnabled || ext.width < 1000 || rt.view->imageInfo().format != VK_FORMAT_R8G8B8A8_UNORM)
+      return;
+
+    static const uint32_t probes[] = { 1, 2, 3, 4, 5, 6, 8, 12, 20, 40 };
+    if (m_ctbloxQuery != nullptr)
+      this->endQuery(m_ctbloxQuery);
+
+    for (uint32_t p : probes) {
+      if (p == m_ctbloxAppDraw && g_ctbloxProbes.load() < 10) {
+        g_ctbloxProbes++;
+        this->ctbloxProbeTarget(p);
+        break;
+      }
+    }
+  }
