+  void DxvkContext::ctbloxTraceDraw(const char* kind, uint32_t count, uint32_t instances) {
+    if (g_ctbloxTraceDraws.load() <= 0)
+      return;
+    g_ctbloxTraceDraws--;
+    m_ctbloxTraceIndex = 40 - uint32_t(g_ctbloxTraceDraws.load());
+    m_ctbloxTraceActive = true;
+
+    const auto& rt = m_state.om.renderTargets.color[0];
+    std::string target = "none";
+    if (rt.view != nullptr) {
+      auto ext = rt.view->imageInfo().extent;
+      target = str::format(ext.width, "x", ext.height, " fmt=", uint32_t(rt.view->info().format));
+    }
+    const auto& vp = m_state.vp.viewports[0];
+    const auto& sc = m_state.vp.scissorRects[0];
+    const auto& sh = m_state.gp.shaders;
+    Logger::warn(str::format("ctblox: draw ", kind, " count=", count, " inst=", instances,
+      " target=", target,
+      " vp=", vp.x, ",", vp.y, " ", vp.width, "x", vp.height,
+      " sc=", sc.offset.x, ",", sc.offset.y, " ", sc.extent.width, "x", sc.extent.height,
+      " blend=", uint32_t(m_state.gp.state.omBlend[0].blendEnable()),
